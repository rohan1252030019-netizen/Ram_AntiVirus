<UserControl x:Class="Aegis.App.Views.IncidentQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aegis.App.ViewModels"
             Background="{StaticResource AppBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="SOAR Incident Triage Queue" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Correlated security alerts, active threats, and automated response actions" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Export to CSV" Command="{Binding ExportCsvCommand}" Background="{StaticResource CardHover}" Foreground="{StaticResource TextPrimary}" Margin="0,0,10,0" Padding="12,6" FontSize="12"/>
                <Button Content="Refresh" Command="{Binding LoadIncidentsCommand}" Padding="14,6" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Filter & Search Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="Severity:" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                <ComboBox Grid.Column="2" SelectedValue="{Binding SelectedSeverity}" SelectedValuePath="Content" VerticalAlignment="Center" Background="#1A1E2B" Foreground="{StaticResource TextPrimary}">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="Critical"/>
                    <ComboBoxItem Content="High"/>
                    <ComboBoxItem Content="Medium"/>
                    <ComboBoxItem Content="Low"/>
                </ComboBox>

                <TextBlock Grid.Column="3" Text="Status:" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                <ComboBox Grid.Column="4" SelectedValue="{Binding SelectedStatus}" SelectedValuePath="Content" VerticalAlignment="Center" Background="#1A1E2B" Foreground="{StaticResource TextPrimary}">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="Open"/>
                    <ComboBoxItem Content="Investigating"/>
                    <ComboBoxItem Content="Contained"/>
                    <ComboBoxItem Content="Resolved"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Incidents DataGrid (Virtualized for performance) -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="0">
            <DataGrid ItemsSource="{Binding FilteredIncidents}" 
                      SelectedItem="{Binding SelectedIncident}"
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      EnableRowVirtualization="True"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{StaticResource TextPrimary}"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource CardBorder}"
                      RowHeight="46">
                <DataGrid.Columns>
                    <!-- Severity Badge -->
                    <DataGridTemplateColumn Header="Severity" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="Bold" Foreground="#0B0D12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                    <DataGridTextColumn Header="Incident Title" Binding="{Binding Title}" Width="3*"/>
                    <DataGridTextColumn Header="Source IP" Binding="{Binding SourceIp}" Width="130"/>
                    <DataGridTextColumn Header="MITRE ATT&amp;CK" Binding="{Binding MitreTechnique}" Width="2*"/>
                    <DataGridTextColumn Header="Detected (UTC)" Binding="{Binding CreatedAt, StringFormat='{}{0:MM/dd HH:mm}'}" Width="110"/>

                    <!-- Action -->
                    <DataGridTemplateColumn Header="Action" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Inspect" 
                                        Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="{StaticResource CardHover}" 
                                        Foreground="{StaticResource PrimaryCyan}" 
                                        Padding="8,4" 
                                        FontSize="11"
                                        VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

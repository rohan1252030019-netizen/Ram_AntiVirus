<UserControl x:Class="Aegis.App.Views.ComplianceMatrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aegis.App.ViewModels"
             Background="{StaticResource AppBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Regulatory Compliance &amp; Security Posture Matrix" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Continuous posture assessment against NIST CSF, CIS Controls, ISO 27001, and SOC 2 Type II" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Refresh Assessment" Command="{Binding LoadDataCommand}" Background="{StaticResource CardHover}" Foreground="{StaticResource TextPrimary}" Padding="14,6" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Error Banner -->
        <Border Grid.Row="1" Background="#33EF4444" BorderBrush="{StaticResource AlertRed}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AlertRed}" FontWeight="SemiBold"/>
        </Border>

        <!-- Posture Summary Cards -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Overall Score Card -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="COMPLIANCE INDEX" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryCyan}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Overview.OverallScore, StringFormat='{}{0}%'}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Overview.AssessedAt, StringFormat='Audited {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Framework Selection Cards -->
            <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                <ListBox ItemsSource="{Binding Frameworks}" SelectedItem="{Binding SelectedFramework}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardHover}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="16,10" Margin="0,0,10,0" Width="180">
                                <StackPanel>
                                    <TextBlock Text="{Binding ShortName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Score, StringFormat='{}{0}% Conformance'}" FontSize="11" Foreground="{StaticResource PrimaryCyan}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Controls Table for Selected Framework -->
        <Border Grid.Row="3" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{Binding SelectedFramework.Name, StringFormat='Controls for {0}'}" FontWeight="Bold" FontSize="13"/>
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Controls}" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True"
                          Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource CardBorder}" RowHeight="38">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Control ID" Binding="{Binding Id}" Width="100"/>
                        <DataGridTextColumn Header="Control Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Subsystem Module" Binding="{Binding Module}" Width="140"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Automated Audit Evidence" Binding="{Binding Evidence}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="4" IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource PrimaryCyan}"/>
    </Grid>
</UserControl>
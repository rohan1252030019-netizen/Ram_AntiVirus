<Window x:Class="Aegis.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Aegis.App.ViewModels"
        Title="Ram Antivirus — Autonomous Defense Console" 
        Height="850" Width="1350"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Navigation & Status Bar -->
        <Border Grid.Row="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Platform Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" Background="{StaticResource PrimaryCyan}" CornerRadius="6" Margin="0,0,12,0">
                        <TextBlock Text="🛡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="RAM ANTIVIRUS" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.0.0 NATIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryCyan}"/>
                    </Border>
                </StackPanel>

                <!-- Center Live Feed Indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource SuccessGreen}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWsConnected}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource AlertRed}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding WsStatusText}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>

                <!-- User Profile & Action Bar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Demo Scenario Launcher -->
                    <Button Content="⚡ Simulate Ransomware (Demo)" 
                            Command="{Binding RunDemoScenarioCommand}" 
                            Background="#7F1D1D" Foreground="#FCA5A5" 
                            BorderBrush="#EF4444" BorderThickness="1"
                            Padding="10,5" Margin="0,0,10,0" FontSize="11" FontWeight="SemiBold"/>

                    <!-- About Dialog -->
                    <Button Content="About" Command="{Binding ShowAboutCommand}" 
                            Background="{StaticResource CardHover}" Foreground="{StaticResource PrimaryCyan}" 
                            Padding="10,5" Margin="0,0,10,0" FontSize="11"/>

                    <Border Background="{StaticResource CardHover}" CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0"/>
                            <Border Background="{StaticResource PrimaryCyan}" CornerRadius="4" Padding="4,1">
                                <TextBlock Text="{Binding UserRoleText}" FontSize="10" FontWeight="Bold" Foreground="#0B0D12"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Button Content="Sign Out" Command="{Binding LogoutCommand}" Background="Transparent" Foreground="{StaticResource TextMuted}" Padding="8,4" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Offline Banner -->
        <Border Grid.Row="1" Background="#7F1D1D" BorderBrush="{StaticResource AlertRed}" BorderThickness="0,0,0,1" Padding="16,8"
                Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="⚠ " FontSize="13" Foreground="#FECACA" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding OfflineMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#FEE2E2" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Body Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Menu -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0" Padding="12,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Title}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding TargetType}"
                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        Foreground="{StaticResource TextPrimary}"
                                        Margin="0,3"
                                        Padding="14,10"
                                        FontSize="13">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryCyan}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Dynamic Viewport -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="0"/>
        </Grid>
    </Grid>
</Window>

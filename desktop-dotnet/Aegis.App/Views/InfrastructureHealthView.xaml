<UserControl x:Class="Aegis.App.Views.InfrastructureHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aegis.App.ViewModels"
             Background="{StaticResource AppBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel MaxWidth="1150" HorizontalAlignment="Left">
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Infrastructure &amp; Endpoint Agent Health" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Host resource utilization, PM2 background daemons, and connected EDR nodes" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="Refresh Status" Command="{Binding LoadSystemsCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,6" FontSize="12"/>
            </Grid>

            <!-- Systems List -->
            <ItemsControl ItemsSource="{Binding Systems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessGreen}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,10,0"/>
                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryCyan}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Os}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Ip, StringFormat='IP: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,16,0"/>
                                        <TextBlock Text="{Binding Uptime, StringFormat='Uptime: {0}'}" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Vitals Grid -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource CardHover}" CornerRadius="6" Padding="14,10" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="CPU UTILIZATION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding Cpu, StringFormat='{}{0:F1}%'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{StaticResource CardHover}" CornerRadius="6" Padding="14,10" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="RAM UTILIZATION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding Mem, StringFormat='{}{0:F1}%'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{StaticResource CardHover}" CornerRadius="6" Padding="14,10">
                                        <StackPanel>
                                            <TextBlock Text="DISK UTILIZATION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding Disk, StringFormat='{}{0:F1}%'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- PM2 Process daemons -->
                                <ItemsControl ItemsSource="{Binding Pm2Processes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}" Width="160"/>
                                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource SuccessGreen}" Width="80"/>
                                                        <TextBlock Text="{Binding Mem, StringFormat='Mem: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondary}" Width="110"/>
                                                        <TextBlock Text="{Binding Uptime, StringFormat='Up: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

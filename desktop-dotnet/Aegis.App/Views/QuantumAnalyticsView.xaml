<UserControl x:Class="Aegis.App.Views.QuantumAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aegis.App.ViewModels"
             Background="{StaticResource AppBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Post-Quantum Cryptography &amp; Entropy Lab" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Quantum-resilient algorithm migration readiness, Shor-algorithm exposure, and Renyi/Shannon entropy tests" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Refresh Readiness" Command="{Binding LoadDataCommand}" Background="{StaticResource CardHover}" Foreground="{StaticResource TextPrimary}" Padding="14,6" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Error Banner -->
        <Border Grid.Row="1" Background="#33EF4444" BorderBrush="{StaticResource AlertRed}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AlertRed}" FontWeight="SemiBold"/>
        </Border>

        <!-- Readiness Metrics Cards -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Score & Grade -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="PQC READINESS GRADE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryCyan}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Readiness.Grade}" FontSize="44" FontWeight="Bold" Foreground="{StaticResource PrimaryCyan}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Readiness.QuantumReadinessScore, StringFormat='Score: {0:F1}/100'}" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Migration Urgency Summary -->
            <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CRYPTO SAFETY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding Readiness.Summary.QuantumSafe, StringFormat='{}{0} Safe'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding Readiness.Summary.TotalAlgorithmsTracked, StringFormat='of {0} tracked'}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="VULNERABLE (SHOR)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding Readiness.Summary.AlreadyVulnerable, StringFormat='{}{0} Algorithms'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AlertRed}" Margin="0,6,0,0"/>
                        <TextBlock Text="RSA / ECC vulnerable" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="MIGRATION URGENCY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding Readiness.Summary.UrgentMigrations, StringFormat='{}{0} Urgent'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningYellow}" Margin="0,6,0,0"/>
                        <TextBlock Text="Kyber/Dilithium targets" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Entropy Analysis Lab -->
        <Border Grid.Row="3" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Renyi &amp; Shannon Payload Entropy Tester" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="0" HorizontalAlignment="Right" Text="Detects encrypted payloads, packed malware, and key material" FontSize="11" Foreground="{StaticResource TextMuted}"/>

                <!-- Input Row -->
                <Grid Grid.Row="1" Margin="0,10,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding PayloadText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="Analyze Entropy" Command="{Binding TestEntropyCommand}" Padding="16,8"/>
                </Grid>

                <!-- Results -->
                <Grid Grid.Row="2" Visibility="{Binding EntropyResult, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource CardHover}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="SHANNON ENTROPY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding EntropyResult.ShannonEntropy, StringFormat='{}{0:F4} bits/byte'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryCyan}" Margin="0,8,0,0"/>
                            <TextBlock Text="Max: 8.0 (pure random/encrypted)" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource CardHover}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="MIN ENTROPY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding EntropyResult.MinEntropy, StringFormat='{}{0:F4} bits/byte'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,8,0,0"/>
                            <TextBlock Text="Worst-case unpredictability" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="{StaticResource CardHover}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="CLASSIFICATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding EntropyResult.Classification}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningYellow}" Margin="0,8,0,0"/>
                            <TextBlock Text="Algorithmic classification" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="4" IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource PrimaryCyan}"/>
    </Grid>
</UserControl>
<UserControl x:Class="Aegis.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aegis.App.ViewModels"
             Background="{StaticResource AppBackground}">
    <Grid>
        <Border Width="420" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <!-- Brand Badge -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Width="48" Height="48" Background="{StaticResource PrimaryCyan}" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="🛡" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="RAM ANTIVIRUS" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Autonomous Endpoint Protection &amp; Security Console" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Error Banner -->
                <Border Background="#450A0A" BorderBrush="{StaticResource AlertRed}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AlertRed}" TextWrapping="Wrap" FontSize="12"/>
                </Border>

                <!-- Server URL & Connection Test -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Backend URL" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding UseMockData}" Content="Offline Demo Mode" Foreground="{StaticResource PrimaryCyan}" FontSize="11" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Test" Command="{Binding TestConnectionCommand}" 
                            IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InverseBoolToVis}}"
                            Background="{StaticResource CardHover}" Foreground="{StaticResource PrimaryCyan}" Padding="12,0" FontSize="12"/>
                </Grid>

                <!-- Connection Ping Feedback -->
                <TextBlock Text="{Binding ConnectionStatus}" Margin="0,0,0,10" FontSize="11"
                           Visibility="{Binding ConnectionStatus, Converter={StaticResource NullToVis}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnectionSuccess}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnectionSuccess}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource AlertRed}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Insecure URL Warning -->
                <Border Background="#451A03" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,-10,0,14" Visibility="{Binding IsInsecureUrl, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠ " Foreground="#F59E0B" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Non-HTTPS remote connection. Credentials sent in plaintext." Foreground="#FDE68A" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Standard Email/Password Login -->
                <StackPanel Visibility="{Binding IsApiKeyMode, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="Email Address" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                    <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <!-- Bound PasswordBox helper / password entry -->
                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                </StackPanel>

                <!-- API Key Login -->
                <StackPanel Visibility="{Binding IsApiKeyMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="X-API-Key" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                </StackPanel>

                <!-- Options -->
                <Grid Margin="0,0,0,20">
                    <CheckBox IsChecked="{Binding RememberMe}" Content="Remember on this PC (DPAPI)" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                    <Button Command="{Binding ToggleModeCommand}" 
                            HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource PrimaryCyan}" Padding="0" FontSize="12">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Use API Key instead"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsApiKeyMode}" Value="True">
                                            <Setter Property="Text" Value="Use Email / Password"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>

                <!-- Submit Button -->
                <Button Content="Connect &amp; Authenticate" Command="{Binding LoginCommand}" IsEnabled="{Binding IsNotBusy}" Height="40" FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

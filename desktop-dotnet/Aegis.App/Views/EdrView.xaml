<UserControl x:Class="Aegis.App.Views.EdrView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aegis.App.ViewModels"
             Background="{StaticResource AppBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="EDR Telemetry &amp; Host Containment" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Endpoint detection events, process termination, file quarantine, and host isolation" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Agent ID:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                <TextBox Text="{Binding AgentId, UpdateSourceTrigger=PropertyChanged}" Width="160" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="Refresh Telemetry" Command="{Binding LoadEventsCommand}" Padding="14,6" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Error / Warning Banner -->
        <Border Grid.Row="1" Background="#33EF4444" BorderBrush="{StaticResource AlertRed}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AlertRed}" FontWeight="SemiBold"/>
        </Border>

        <!-- Destructive Operations Panel -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Process Kill -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Kill Process (PID)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SelectedPid, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Kill Process" Command="{Binding KillProcessCommand}" Background="#7F991B1B" Foreground="{StaticResource AlertRed}" Padding="12,6"/>
                    </Grid>
                </StackPanel>

                <!-- File Quarantine -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Quarantine File Path" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding TargetFilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Quarantine" Command="{Binding QuarantineFileCommand}" Background="#7F991B1B" Foreground="{StaticResource AlertRed}" Padding="12,6"/>
                    </Grid>
                </StackPanel>

                <!-- Host Isolation -->
                <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Button Content="Isolate Host" Command="{Binding IsolateHostCommand}" Background="{StaticResource AlertRed}" Foreground="#090B10" Padding="14,8" Margin="0,0,8,0"/>
                    <Button Content="Unisolate Host" Command="{Binding UnisolateHostCommand}" Background="{StaticResource CardHover}" Foreground="{StaticResource SuccessGreen}" Padding="14,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Events Grid (Virtualized) -->
        <Border Grid.Row="3" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8">
            <DataGrid ItemsSource="{Binding Events}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      CanUserResizeRows="False" 
                      EnableRowVirtualization="True" 
                      Background="Transparent" 
                      BorderThickness="0" 
                      Foreground="{StaticResource TextPrimary}" 
                      GridLinesVisibility="Horizontal" 
                      HorizontalGridLinesBrush="{StaticResource CardBorder}" 
                      RowHeight="42">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Event ID" Binding="{Binding Id}" Width="110"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                    <DataGridTextColumn Header="Event Title" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Loading overlay indicator -->
        <ProgressBar Grid.Row="4" IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource PrimaryCyan}"/>
    </Grid>
</UserControl>
<UserControl x:Class="Aegis.App.Views.DashboardOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aegis.App.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="{StaticResource AppBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel MaxWidth="1150" HorizontalAlignment="Left">
            <!-- Header Section -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Security Operations Overview" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Autonomous threat detection, correlation, and endpoint response" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="6" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Triage Latency: " FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding AvgTriageTimeMs, StringFormat='{}{0:F2} ms'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryCyan}"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Refresh" Command="{Binding RefreshDataCommand}" Padding="14,6" FontSize="12"/>
                </StackPanel>
            </Grid>

            <!-- 4 Metric KPI Cards -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Active Threats -->
                <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="ACTIVE THREATS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding ActiveThreats}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AlertRed}" Margin="0,8,0,4"/>
                        <TextBlock Text="Requires investigation" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- Incidents Today -->
                <Border Grid.Column="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="INCIDENTS TODAY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding IncidentsToday}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource WarningYellow}" Margin="0,8,0,4"/>
                        <TextBlock Text="Correlated Sigma events" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- Assets Protected -->
                <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="PROTECTED ASSETS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding AssetsProtected}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryCyan}" Margin="0,8,0,4"/>
                        <TextBlock Text="Endpoints &amp; Core Daemons" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- Blocked IPs -->
                <Border Grid.Column="3" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="FIREWALL BLOCKS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding BlockedIpsCount}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,8,0,4"/>
                        <TextBlock Text="Safe-IP guarded drops" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 7-Day Timeline Trend & Quick Containment -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 7-Day Incident Trend -->
                <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="7-Day Incident &amp; Threat Trend" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                        <lvc:CartesianChart Series="{Binding TrendSeries}" XAxes="{Binding XAxes}" Height="180" Background="Transparent" Margin="0,0,0,16"
                                            Visibility="{Binding TrendSeries, Converter={StaticResource BoolToVis}}"/>

                        <ItemsControl ItemsSource="{Binding TimelineEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <TextBlock Text="{Binding Date}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="Incidents: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                <TextBlock Text="{Binding IncidentCount}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="12" Margin="0,0,16,0"/>
                                                <TextBlock Text="Threats: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                <TextBlock Text="{Binding ThreatCount}" Foreground="{StaticResource AlertRed}" FontWeight="Bold" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Quick Action Playbooks -->
                <Border Grid.Column="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Autonomous SOC Playbooks" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14"/>
                        <TextBlock Text="Execute or audit automated containment pipelines across endpoint and perimeter tiers." Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <Button Content="Inspect Triage Queue" Command="{Binding GoToIncidentQueueCommand}" Height="38" Margin="0,0,0,12"/>
                        <Button Content="Firewall &amp; DoS Shield" Command="{Binding GoToFirewallCommand}" Background="{StaticResource CardHover}" Foreground="{StaticResource TextPrimary}" Height="38"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

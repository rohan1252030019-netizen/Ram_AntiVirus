<UserControl x:Class="Aegis.App.Views.AntivirusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aegis.App.ViewModels"
             Background="{StaticResource AppBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Antivirus &amp; Quarantine Vault" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Signature databases, file hash intelligence, and isolated malicious artifact vault" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Update Signatures" Command="{Binding UpdateSignaturesCommand}" Background="{StaticResource PrimaryCyan}" Margin="0,0,10,0" Padding="14,6" FontSize="12"/>
                <Button Content="Refresh" Command="{Binding LoadDataCommand}" Background="{StaticResource CardHover}" Foreground="{StaticResource TextPrimary}" Padding="14,6" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Error / Status Banners -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Border Background="#33EF4444" BorderBrush="{StaticResource AlertRed}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AlertRed}" FontWeight="SemiBold"/>
            </Border>
            <Border Background="#3322C55E" BorderBrush="{StaticResource SuccessGreen}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                    Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessGreen}" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>

        <!-- Info Cards: Signature Status & Hash Lookup -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Signature Card -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Signature Database" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryCyan}" Margin="0,0,0,8"/>
                    <Grid Margin="0,2">
                        <TextBlock Text="Database Version:" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock Text="{Binding Signatures.Version}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Active Rule Count:" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock Text="{Binding Signatures.BadHashCount}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Last Updated:" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock Text="{Binding Signatures.GeneratedAt}" HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Hash Lookup Card -->
            <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding HashToLookup, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Lookup Hash" Command="{Binding LookupHashCommand}" Padding="14,6"/>
                    </Grid>
                    <!-- Hash Result Details -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HashResult, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Known Bad:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding HashResult.KnownBad}" FontWeight="Bold" Foreground="{StaticResource AlertRed}" Margin="0,0,16,0"/>
                        <TextBlock Text="SHA256:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding HashResult.Sha256}" FontWeight="Bold" Margin="0,0,16,0"/>
                        <TextBlock Text="Local Detections:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding HashResult.LocalDetections}" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Quarantine Items Table -->
        <Border Grid.Row="3" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,12">
                    <TextBlock Text="Quarantined Artifacts" FontWeight="Bold" FontSize="14"/>
                    <Button Content="Release Selected" Command="{Binding ReleaseQuarantineCommand}" HorizontalAlignment="Right" Background="#7F991B1B" Foreground="{StaticResource AlertRed}" Padding="12,4" FontSize="11"/>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding QuarantineItems}"
                          SelectedItem="{Binding SelectedQuarantineItem}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          EnableRowVirtualization="True"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{StaticResource TextPrimary}"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource CardBorder}"
                          RowHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Detection ID" Binding="{Binding Id}" Width="120"/>
                        <DataGridTextColumn Header="Rule / Engine" Binding="{Binding Rule}" Width="160"/>
                        <DataGridTextColumn Header="File Path" Binding="{Binding Path}" Width="2*"/>
                        <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="140"/>
                        <DataGridTextColumn Header="Detected At" Binding="{Binding DetectedAt}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Loading Bar -->
        <ProgressBar Grid.Row="4" IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource PrimaryCyan}"/>
    </Grid>
</UserControl>
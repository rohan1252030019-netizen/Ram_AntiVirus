<UserControl x:Class="Aegis.App.Views.PhantomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aegis.App.ViewModels"
             Background="{StaticResource AppBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Phantom Honeygrid &amp; Deception Traps" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Deploy decoy endpoints, capture adversary telemetry, and track recurrent attacker profiles" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Refresh Traps" Command="{Binding LoadDataCommand}" Background="{StaticResource CardHover}" Foreground="{StaticResource TextPrimary}" Padding="14,6" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Alerts -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Border Background="#33EF4444" BorderBrush="{StaticResource AlertRed}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AlertRed}" FontWeight="SemiBold"/>
            </Border>
            <Border Background="#3322C55E" BorderBrush="{StaticResource SuccessGreen}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                    Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessGreen}" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>

        <!-- New Decoy Form -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Decoy Name:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding NewHoneypotName, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <TextBlock Grid.Column="2" Text="Service:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,8,0"/>
                <TextBox Grid.Column="3" Text="{Binding NewHoneypotService, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <TextBlock Grid.Column="4" Text="Port:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,8,0"/>
                <TextBox Grid.Column="5" Text="{Binding NewHoneypotPort, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <Button Grid.Column="6" Content="Deploy Trap" Command="{Binding CreateHoneypotCommand}" Padding="16,8"/>
            </Grid>
        </Border>

        <!-- Honeypots & Telemetry Grids -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Active Honeypots -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Active Honeypots" FontWeight="Bold" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Rotate" Command="{Binding RotateHoneypotCommand}" Background="{StaticResource CardHover}" Foreground="{StaticResource PrimaryCyan}" Padding="10,4" Margin="0,0,6,0" FontSize="11"/>
                            <Button Content="Delete" Command="{Binding DeleteHoneypotCommand}" Background="#7F991B1B" Foreground="{StaticResource AlertRed}" Padding="10,4" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Honeypots}" SelectedItem="{Binding SelectedHoneypot}"
                              AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True"
                              Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource CardBorder}" RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Trap Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding HoneypotType}" Width="80"/>
                            <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60"/>
                            <DataGridTextColumn Header="Interactions" Binding="{Binding InteractionsCount}" Width="90"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Attacker Profiles -->
            <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Top Identified Attackers" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Attackers}"
                              AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True"
                              Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource CardBorder}" RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Attacker IP" Binding="{Binding SourceIp}" Width="120"/>
                            <DataGridTextColumn Header="Interactions" Binding="{Binding TotalInteractions}" Width="90"/>
                            <DataGridTextColumn Header="Sophistication" Binding="{Binding Sophistication}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="4" IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource PrimaryCyan}"/>
    </Grid>
</UserControl>
<UserControl x:Class="Aegis.App.Views.DosShieldView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aegis.App.ViewModels"
             Background="{StaticResource AppBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Autonomous DoS / DDoS Shield" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Real-time layer 7 volumetric inspection, rate-limiting thresholds, and abusive traffic mitigations" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Refresh" Command="{Binding LoadDataCommand}" Background="{StaticResource CardHover}" Foreground="{StaticResource TextPrimary}" Padding="14,6" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Error Banner -->
        <Border Grid.Row="1" Background="#33EF4444" BorderBrush="{StaticResource AlertRed}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AlertRed}" FontWeight="SemiBold"/>
        </Border>

        <!-- Metric Gauges / Status Cards -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Status Card -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="SHIELD MODE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding Status.Mode}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryCyan}" Margin="0,8,0,0"/>
                    <TextBlock Text="Autonomous NetShield Filter" FontSize="11" Foreground="{StaticResource SuccessGreen}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Current RPS -->
            <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="GLOBAL TRAFFIC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding Status.GlobalRps, StringFormat='{}{0:F1} RPS'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,8,0,0"/>
                    <TextBlock Text="Total cluster ingress" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Under Attack -->
            <Border Grid.Column="4" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="ATTACK DETECTED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding Status.UnderAttack}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AlertRed}" Margin="0,8,0,0"/>
                    <TextBlock Text="Active L7 flood status" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- NetShield Status -->
            <Border Grid.Column="6" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="NETSHIELD ENGAGED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding Status.NetshieldEnabled}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningYellow}" Margin="0,8,0,0"/>
                    <TextBlock Text="Netshield / iptables gate" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Offenders Table -->
        <Border Grid.Row="3" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Top Volumetric Offenders" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Offenders}" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True"
                          Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource CardBorder}" RowHeight="38">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Offender IP" Binding="{Binding Ip}" Width="160"/>
                        <DataGridTextColumn Header="Peak RPS" Binding="{Binding Rps}" Width="100"/>
                        <DataGridTextColumn Header="Concurrency" Binding="{Binding Concurrency}" Width="100"/>
                        <DataGridTextColumn Header="Mitigation Reason" Binding="{Binding LastReason}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="4" IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource PrimaryCyan}"/>
    </Grid>
</UserControl>
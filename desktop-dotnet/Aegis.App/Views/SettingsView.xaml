<UserControl x:Class="Aegis.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aegis.App.ViewModels"
             Background="{StaticResource AppBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel MaxWidth="850" HorizontalAlignment="Left">
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="System Settings &amp; Parameters" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Safe-IP whitelists, encrypted notification credentials, and platform options" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="Save Configuration" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Height="36" Padding="18,6"/>
            </Grid>

            <!-- Tenant & Safe-IP Whitelist -->
            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Client Identity &amp; Safe-IP Guardrails" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                    <TextBlock Text="Deployment Name" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                    <TextBlock Text="Safe IP Addresses / Subnets (Comma-separated, mathematically protected from firewall blocks)" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding SafeIpsText, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,8"/>
                    <TextBlock Text="Example: 127.0.0.1, 192.168.1.1, 10.0.0.0/24, 100.64.0.0/10" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Border>

            <!-- Encrypted Notification Channels (Masked for Security) -->
            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Automated Incident Notifications" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <CheckBox IsChecked="{Binding NotificationsEnabled}" Content="Enable Real-Time Alerts" Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>

                    <CheckBox IsChecked="{Binding CriticalOnly}" Content="Dispatch CRITICAL alerts only (Limit alert fatigue)" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,20"/>

                    <!-- Telegram Integration (Masked token) -->
                    <TextBlock Text="Telegram Bot API Token (Masked)" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding TelegramToken, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="Test Telegram" Command="{Binding TestAlertCommand}" CommandParameter="telegram" Background="{StaticResource CardHover}" Foreground="{StaticResource PrimaryCyan}" Padding="12,6" FontSize="12"/>
                    </Grid>

                    <TextBlock Text="Telegram Target Chat ID" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                    <!-- Discord / Custom Webhook (Masked URL) -->
                    <TextBlock Text="Webhook URL (Discord / Slack / Teams — Masked)" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding WebhookUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="Test Webhook" Command="{Binding TestAlertCommand}" CommandParameter="webhook" Background="{StaticResource CardHover}" Foreground="{StaticResource PrimaryCyan}" Padding="12,6" FontSize="12"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="Aegis.App.Views.NodeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aegis.App.ViewModels"
             Background="{StaticResource AppBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Distributed Node Cluster &amp; Agent Registry" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Manage registered server agents, monitor hardware metrics, and enroll new endpoint hosts" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Refresh Nodes" Command="{Binding LoadDataCommand}" Background="{StaticResource CardHover}" Foreground="{StaticResource TextPrimary}" Padding="14,6" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Alerts -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Border Background="#33EF4444" BorderBrush="{StaticResource AlertRed}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AlertRed}" FontWeight="SemiBold"/>
            </Border>
            <Border Background="#3322C55E" BorderBrush="{StaticResource SuccessGreen}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                    Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessGreen}" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>

        <!-- Enroll Node Form -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Enrollment Token:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding EnrollCode, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <TextBlock Grid.Column="2" Text="Node Type:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="3" SelectedValue="{Binding EnrollNodeType}" SelectedValuePath="Content" VerticalAlignment="Center" Background="#1A1E2B" Foreground="{StaticResource TextPrimary}" Margin="0,0,16,0">
                    <ComboBoxItem Content="workspace" IsSelected="True"/>
                    <ComboBoxItem Content="server"/>
                    <ComboBoxItem Content="sensor"/>
                </ComboBox>

                <Button Grid.Column="4" Content="Enroll Endpoint Node" Command="{Binding EnrollNodeCommand}" Padding="16,8"/>
            </Grid>
        </Border>

        <!-- Nodes Table and Metric Inspector -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Table -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Enrolled Fleet Hosts" FontWeight="Bold" FontSize="13"/>
                        <Button Content="Unregister Node" Command="{Binding DeleteNodeCommand}" HorizontalAlignment="Right" Background="#7F991B1B" Foreground="{StaticResource AlertRed}" Padding="10,4" FontSize="11"/>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}"
                              AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True"
                              Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource CardBorder}" RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="*"/>
                            <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="110"/>
                            <DataGridTextColumn Header="OS" Binding="{Binding OsInfo}" Width="100"/>
                            <DataGridTextColumn Header="Agent" Binding="{Binding AgentVersion}" Width="70"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Node Inspector / Hardware Metrics -->
            <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Visibility="{Binding SelectedNode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="NODE HARDWARE METRICS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryCyan}" Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding SelectedNode.Hostname}" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedNode.Id, StringFormat='ID: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,16"/>

                    <!-- Metric Bars -->
                    <Grid Margin="0,6">
                        <TextBlock Text="CPU Utilization:" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedNode.Cpu, StringFormat='{}{0:F1}%'}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12"/>
                    </Grid>
                    <ProgressBar Value="{Binding SelectedNode.Cpu}" Maximum="100" Height="8" Background="#1A1E2B" Foreground="{StaticResource PrimaryCyan}" Margin="0,2,0,12"/>

                    <Grid Margin="0,6">
                        <TextBlock Text="Memory Usage:" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedNode.Mem, StringFormat='{}{0:F1}%'}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12"/>
                    </Grid>
                    <ProgressBar Value="{Binding SelectedNode.Mem}" Maximum="100" Height="8" Background="#1A1E2B" Foreground="{StaticResource PrimaryCyan}" Margin="0,2,0,12"/>

                    <Grid Margin="0,6">
                        <TextBlock Text="Storage Disk Usage:" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedNode.Disk, StringFormat='{}{0:F1}%'}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12"/>
                    </Grid>
                    <ProgressBar Value="{Binding SelectedNode.Disk}" Maximum="100" Height="8" Background="#1A1E2B" Foreground="{StaticResource PrimaryCyan}" Margin="0,2,0,16"/>

                    <Separator Background="{StaticResource CardBorder}" Margin="0,8"/>

                    <Grid Margin="0,4">
                        <TextBlock Text="Running Processes:" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedNode.Processes}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <TextBlock Text="Monitored Assets:" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedNode.AssetCount}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <TextBlock Text="Heartbeat:" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedNode.LastHeartbeat}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="4" IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource PrimaryCyan}"/>
    </Grid>
</UserControl>
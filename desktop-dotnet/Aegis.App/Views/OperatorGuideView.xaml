<UserControl x:Class="Aegis.App.Views.OperatorGuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aegis.App.ViewModels"
             Background="{StaticResource AppBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="SOC Operator Playbook &amp; Console Guide" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Incident response standard operating procedures, console keyboard shortcuts, and triage guidelines" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Content Split: Playbook & Shortcuts -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Standard Incident Response Playbooks -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="STANDARD OPERATING PROCEDURES (IR PLAYBOOKS)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryCyan}" Margin="0,0,0,14"/>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding PlaybookSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardHover}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Border Background="{StaticResource PrimaryCyan}" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Code}" FontSize="11" FontWeight="Bold" Foreground="#090B10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,6" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="2" Text="{Binding ActionCommand, StringFormat='Recommended Console Route: {0}'}" FontSize="11" Foreground="{StaticResource PrimaryCyan}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Keyboard Shortcuts & Controls -->
            <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="CONSOLE KEYBOARD NAVIGATION" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryCyan}" Margin="0,0,0,14"/>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Shortcuts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Border Background="#1E2333" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Width="80">
                                        <TextBlock Text="{Binding Shortcut}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryCyan}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Action}" FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="96,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
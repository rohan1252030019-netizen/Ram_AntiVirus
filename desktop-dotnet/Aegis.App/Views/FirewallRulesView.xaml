<UserControl x:Class="Aegis.App.Views.FirewallRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aegis.App.ViewModels"
             Background="{StaticResource AppBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel MaxWidth="1150" HorizontalAlignment="Left">
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Autonomous Firewall &amp; Perimeter Shield" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Active iptables / pfctl blocklist, provisional self-expiring drops, and rule policies" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="Refresh" Command="{Binding LoadFirewallDataCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,6" FontSize="12"/>
            </Grid>

            <!-- Active Blocked IPs Table -->
            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Active Blocklist (Safe-IP Guarded)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14"/>
                    <DataGrid ItemsSource="{Binding BlockedIps}" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Blocked IP" Binding="{Binding Ip}" Width="160"/>
                            <DataGridTextColumn Header="Reason / Rule" Binding="{Binding Reason}" Width="2*"/>
                            <DataGridTextColumn Header="Blocked At (UTC)" Binding="{Binding BlockedAt, StringFormat='{}{0:MM/dd HH:mm}'}" Width="150"/>
                            <DataGridTextColumn Header="Expires (TTL)" Binding="{Binding ExpiresAt, StringFormat='{}{0:MM/dd HH:mm}'}" Width="150"/>
                            <DataGridCheckBoxColumn Header="Provisional" Binding="{Binding IsProvisional}" Width="100"/>
                            <DataGridTemplateColumn Header="Action" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Unblock" 
                                                Command="{Binding DataContext.UnblockIpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="{StaticResource CardHover}" 
                                                Foreground="{StaticResource AlertRed}" 
                                                Padding="8,4" 
                                                FontSize="11"
                                                VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Firewall Rule Definitions -->
            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="Firewall Rule Policies" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14"/>
                    <DataGrid ItemsSource="{Binding Rules}" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="90"/>
                            <DataGridTextColumn Header="Rule Name" Binding="{Binding Name}" Width="250"/>
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="90"/>
                            <DataGridTextColumn Header="Policy Definition (YAML)" Binding="{Binding YamlDef}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
